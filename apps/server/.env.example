# --- OpenReel Server (NestJS) ---

# HTTP
PORT=4000
# Comma-separated origins allowed for CORS
OPENREEL_CORS=http://localhost:5173,http://127.0.0.1:5173

# Data dir (SQLite db, uploads, rendered output, plugin state)
# default: ~/.openreel/server
# OPENREEL_DATA_DIR=

# Secret used to encrypt-at-rest connector credentials
OPENREEL_SECRET=change-me

# Plugins directory (manifest.json + index.cjs/js per folder)
# default: <repo>/plugins
# OPENREEL_PLUGIN_DIR=

# --- opencode2 LLM gateway (OpenAI-compatible) ---
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_API_KEY=
OPENCODE_MODEL=glm-5.3-flash

# --- Optional direct providers for adapter comparison ---
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=

# --- Image generation for the local-compose engine ---
# Any OpenAI-compatible /images/generations endpoint
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gemini-2.5-flash-image

# --- Static FFmpeg binary (defaults to `ffmpeg` on PATH) ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=

# --- Publish connector credentials (prefer Plugin Center UI; env fallback) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
BILIBILI_APP_KEY=
BILIBILI_APP_SECRET=
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
XHS_COOKIE=
