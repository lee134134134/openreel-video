# --- OpenReel Server (NestJS) ---

# HTTP
PORT=4000
# Comma-separated origins allowed for CORS
OPENREEL_CORS=http://localhost:5173,http://127.0.0.1:5173

# Data dir (SQLite db, uploads, rendered output, plugin state)
# default: ~/.openreel/server
# OPENREEL_DATA_DIR=

# Secret used to encrypt-at-rest connector credentials (AES-256-GCM).
# 生产/长期使用请改成随机长字符串；修改后已保存的平台凭据需要重新填写。
OPENREEL_SECRET=change-me

# Plugins directory (manifest.json + index.cjs/js per folder)
# default: <repo>/plugins
# OPENREEL_PLUGIN_DIR=

# --- opencode2 LLM gateway（自动对接两个账号的 free 模型）---
# 服务端启动时会探测下面两个端点，并自动选择可用模型：
#   1) OpenCode Go      https://opencode.ai/inference/go/openai/v1   （主账号，优先 hy4）
#   2) personal/opencode https://opencode.ai/inference/openai/v1     （备用账号）
# Key 可从环境变量提供，也可从 ~/.local/share/opencode/auth.json 的 opencode.key 读取。
# OPENCODE_MODEL 显式指定时优先使用（例如 hy4）；该模型额度用尽（429/402）会先在同一
# 账户内自动降级到 hy4-flash-free，仍失败才切到备用账户。
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_API_KEY=
OPENCODE_MODEL=hy4

# --- 限额自动切换（个人免费 OpenCode 账户）---
# Go 额度用完（429/402/401）后自动切到 personal/opencode 的 free 模型，
# 恢复窗口过后会自动回探主账户。
# OPENCODE_FALLBACK_BASE_URL=https://opencode.ai/inference/openai/v1
# OPENCODE_FALLBACK_API_KEY=
# OPENCODE_FALLBACK_MODEL=deepseek-v4.1-flash-free
# 切到备用账户多少毫秒后重新试探主账户（默认 600000 = 10 分钟；0 = 进程内不再回切）
# OPENCODE_FAILOVER_RECOVERY_MS=

# --- Optional direct providers for adapter comparison ---
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=

# --- Image generation for the local-compose engine ---
# Any OpenAI-compatible /images/generations endpoint
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gemini-2.5-flash-image

# --- Real dynamic video generation (I2V / T2V) ---
# 配置后每个场景先生成关键帧首帧，再调用视频模型产出真实动态片段；未配置时
# 合成器会把同一镜头的 2–4 张关键帧交叉溶解，并叠加一条贯穿整场的连续运镜，
# 保证离线也能得到连贯运动画面，而不是单张定格 PPT。
# 支持 Kling/即梦/Wan 风格的任务轮询接口，也支持 OpenAI 风格直出接口。
# VIDEO_BASE_URL=https://your-video-gateway.example.com
# VIDEO_API_KEY=
# VIDEO_MODEL=kling-v1-6
# VIDEO_CREATE_PATH=/v1/videos/generations
# VIDEO_TASK_PATH=/v1/videos/generations/{id}
# VIDEO_MODE=auto                # auto | i2v | t2v
# VIDEO_PAYLOAD_STYLE=generic    # generic | kling | openai
# VIDEO_POLL_INTERVAL_MS=2000
# VIDEO_POLL_TIMEOUT_MS=180000

# --- Narration (TTS) ---
# OpenAI-compatible /audio/speech endpoint; point OPENAI_TTS_BASE_URL at an
# aggregator relay to use third-party keys instead of api.openai.com
OPENAI_API_KEY=
OPENAI_TTS_BASE_URL=
OPENAI_TTS_MODEL=

# --- Azure Speech TTS (免费 F0 层：每月 50 万神经字符) ---
# 在 portal.azure.com 创建「语音 / Speech」资源（定价层选 免费F0），复制 Key 1
# 和区域填到这里。设置后 azure-tts 自动成为默认配音（优先级高于 edge-tts）。
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastasia
# 可选：默认情绪风格（Azure express-as），如 cheerful / friendly / gentle / sad
# AZURE_TTS_STYLE=
# 可选：情绪强度 0.01~2，默认 1（越大越夸张）
# AZURE_TTS_STYLE_DEGREE=1.2

# --- CosyVoice 本地开源语音（完全免费 · 情绪指令） ---
# 先运行 bash services/cosyvoice/setup.sh 安装，再启动服务：
#   cd services/cosyvoice && ./venv/bin/python serve.py
# 安装完成后重启本服务即自动启用（优先级高于 edge-tts）。
# 远程模式（如 Colab 免费 GPU 隧道）只需填 URL，无需本地安装：
# COSYVOICE_URL=
# COSYVOICE_PROMPT_WAV=
# COSYVOICE_STYLE=
# 默认语速；小于 1 更沉稳（0.95 默认）：
# COSYVOICE_SPEED=0.95
# 固定沉稳配音：忽略分镜情绪，始终用沉稳指令 + 默认语速：
# COSYVOICE_LOCK_STEADY=1
# 自然停顿：CosyVoice3 在长从句后插入 [breath] 音频事件，最多 2 处；
# auto（默认）= 仅 CosyVoice3 启用；0 关闭；1 强制开启（改后需重启 TTS 服务）：
# COSYVOICE_BREATH=auto
# 响度归一化（默认提升到 -16 LUFS；置空可关闭）：
# COSYVOICE_LOUDNORM=loudnorm=I=-16:TP=-1.5:LRA=11

# --- Edge TTS（免费在线神经语音，无需 Key） ---
# 首次合成前自动在 services/edge-tts 安装纯 Python 客户端；也可先手动
#   bash services/edge-tts/setup.sh
# 默认音色（晓晓）；也可传任意 edge-tts 音色 id：
# EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# 指定 Python 解释器 / 服务目录（venv 装在别处时）：
# EDGE_TTS_PYTHON=
# EDGE_TTS_SERVICE_DIR=
# 设为 0 时，venv 缺失不再自动运行 setup.sh：
# EDGE_TTS_AUTO_SETUP=1

# --- macOS 系统语音（darwin 离线兜底，零依赖） ---
# 默认音色 Tingting；可用 `say -v ?` 查看系统音色：
# MACOS_SAY_VOICE=Tingting

# --- LLM 请求细节 ---
# 单次请求超时（毫秒，默认 120000）：
# OPENCODE_TIMEOUT_MS=120000
# 场景插画走 LLM 生成 SVG 时使用的模型（默认跟随 OPENCODE_MODEL）：
# OPENCODE_IMAGE_MODEL=

# --- Static FFmpeg binary (defaults to `ffmpeg` on PATH) ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=
# 字幕/占位卡文字使用的字体（默认 macOS 用 PingFang SC，其他平台 sans）：
# FFMPEG_DRAWTEXT_FONT=PingFang SC
# 同时执行的渲染任务数（默认 1；本机 CPU/内存足够时可调大）：
# OPENREEL_RENDER_CONCURRENCY=1

# --- Publish connector credentials (prefer Plugin Center UI; env fallback) ---
# 凭据写入 SQLite 时用 OPENREEL_SECRET 做 AES-256-GCM 加密；修改 secret 后
# 旧凭据无法解密，需要在插件中心重新填写。
# 设为 1 时拒绝所有发布请求（演示/公开部署时可用）：
# OPENREEL_DISABLE_PUBLISH=0
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
BILIBILI_APP_KEY=
BILIBILI_APP_SECRET=
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
XHS_COOKIE=
