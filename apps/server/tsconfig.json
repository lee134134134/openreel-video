{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "strict": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["node", "multer"],
    "paths": {
      "@openreel/plugin-sdk": ["../../packages/plugin-sdk/src/index.ts"],
      "@openreel/plugin-sdk/*": ["../../packages/plugin-sdk/src/*"]
    }
  },
  "include": ["src"]
}
